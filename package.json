{
  "name": "@tnotesjs/mindmap-core",
  "version": "0.1.1",
  "description": "Markdown-first mind map engine used by TNotesJS web, VS Code and read-only renderers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnotesjs/mindmap-core.git"
  },
  "homepage": "https://github.com/tnotesjs/mindmap-core#readme",
  "bugs": {
    "url": "https://github.com/tnotesjs/mindmap-core/issues"
  },
  "keywords": [
    "mindmap",
    "markdown",
    "outline",
    "tnotesjs"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
